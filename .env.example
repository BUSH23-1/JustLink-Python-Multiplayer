# ==============================================================================
# Automated Multi-Platform Posting System - Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your `.env` file containing live secrets to source control.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=4000
DEBUG=false
ENVIRONMENT=production
HTTP_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 1. Instagram Graph API (Meta for Developers)
# ------------------------------------------------------------------------------
# Requirements:
# - Instagram Professional / Business Account linked to a Facebook Page.
# - Meta Developer App with "Instagram Graph API" product enabled.
# - User / Page Access Token with permissions:
#     - instagram_basic
#     - instagram_content_publish
#     - pages_show_list
#     - pages_read_engagement
#
# Obtain INSTAGRAM_ACCOUNT_ID:
#   GET https://graph.facebook.com/v19.0/me/accounts?access_token={token}
#   Look for instagram_business_account.id
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_or_page_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here
INSTAGRAM_IMAGE_URL=https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80
INSTAGRAM_API_VERSION=v19.0

# ------------------------------------------------------------------------------
# 2. LinkedIn Posts API
# ------------------------------------------------------------------------------
# Requirements:
# - LinkedIn Developer App configured at https://www.linkedin.com/developers/
# - Products enabled: "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect"
# - OAuth 2.0 Access Token with scopes:
#     - w_member_social (for personal profile posts)
#     - w_organization_social (for organization/company page posts)
#
# LINKEDIN_AUTHOR_URN:
#   Format for personal profile: urn:li:person:{person_id}
#   Format for organization: urn:li:organization:{organizatioAQWZ1AHIdvnbCmuwL69FS2oHXnX-IxYlTLHyLpTdTU3VbSR36R0QNc8SQSMFFf-KZhe2V_VWjtosv5tsfWlKHJoQbRFGQtfJfhrIZ_6g79yJ_py-U3dUdShmAWczbaCrdjfwUZYHMYunQS1NnwHvpwJrqcUSnM6HTLL3bd6BQq7Nc6N5XRHWwUtbwvDHxpfeuv7ldEAggrZnNdECyuDFZhvLoupCGse8cpCcp3Us6RkxRbURFbj1ggTX9Pk4fvmorcvH2Z1FzknvuWKM27Jffv_FbssnUZBZLs6SwynFzYgZFNlwgwRqng7bSjg24dTMFue4sFxj25D7xCymOW1GtfMBo_DFcwn_id}
#   Obtain personal URN via: GET https://api.linkedin.com/v2/userinfo
LINKEDIN_ACCESS_TOKEN=AQWZ1AHIdvnbCmuwL69FS2oHXnX-IxYlTLHyLpTdTU3VbSR36R0QNc8SQSMFFf-KZhe2V_VWjtosv5tsfWlKHJoQbRFGQtfJfhrIZ_6g79yJ_py-U3dUdShmAWczbaCrdjfwUZYHMYunQS1NnwHvpwJrqcUSnM6HTLL3bd6BQq7Nc6N5XRHWwUtbwvDHxpfeuv7ldEAggrZnNdECyuDFZhvLoupCGse8cpCcp3Us6RkxRbURFbj1ggTX9Pk4fvmorcvH2Z1FzknvuWKM27Jffv_FbssnUZBZLs6SwynFzYgZFNlwgwRqng7bSjg24dTMFue4sFxj25D7xCymOW1GtfMBo_DFcw
LINKEDIN_AUTHOR_URN=urn:li:person:umeBrrr7dC
LINKEDIN_API_VERSION=202401

# ------------------------------------------------------------------------------
# 3. Telegram Bot API
# ------------------------------------------------------------------------------
# Requirements:
# - Create a bot via @BotFather on Telegram (https://t.me/BotFather) to get TELEGRAM_BOT_TOKEN.
# - Add your bot as an Administrator to your target Channel or Supergroup with "Post Messages" permission.
# - TELEGRAM_CHAT_ID:
#     - For public channels: @your_channel_username (e.g., @my_business_channel)
#     - For private channels/groups: -100xxxxxxxxxx (numerical ID)

TELEGRAM_BOT_TOKEN=9145248926:AAEyIg9SEXe7J1oMOktpi-OksrvTy40QqvE
TELEGRAM_CHAT_ID=@bushconnect

# ------------------------------------------------------------------------------
# 4. Discord Webhooks API
# ------------------------------------------------------------------------------
# Requirements:
# - In your Discord Server:
#     - Channel Settings -> Integrations -> Webhooks -> New Webhook
#     - Copy Webhook URL.
# - DISCORD_GUILD_ID (Optional, used to construct direct channel navigation link):
#     - Right-click your Discord server icon -> Copy Server ID (Developer Mode on)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1571445205524160512/dn5yC4S9hbjvgKE1EIfBZIiGWwmwQP6IBGOEia1RuWdPStvK97sRF3JAOVavetiAUuyT
DISCORD_GUILD_ID=1571443260776521848


